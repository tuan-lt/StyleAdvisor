# Application Public URL (supports http://localhost:3000 and https://StyleAdvisor.online)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic API Key (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# OpenAI API Key (GPT-4o) - Alternative LLM provider
OPENAI_API_KEY=

# OpenRouter API Key (Gemini, Claude, GPT, Free Tier)
OPENROUTER_API_KEY=

# Enable/Disable AI Model Selection in Admin (true = enabled, false = disabled)
ENABLE_AI_MODEL_SELECTION=true

# Admin & Chrome Extension Ingestion Hub Security Key
ADMIN_INGEST_API_KEY=sa_dev_secret_key_2026

# Server Configuration
PORT=3000
NODE_ENV=development
